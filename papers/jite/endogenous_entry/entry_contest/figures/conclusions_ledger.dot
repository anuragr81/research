digraph conclusions {
rankdir=LR; nodesep=0.5; ranksep=1.6;
node [fontname="Helvetica", fontsize=11, shape=plaintext];
edge [fontname="Helvetica", fontsize=9];
fontname="Helvetica";
"challenger" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#999999"><tr><td colspan="2" bgcolor="#c8e6c9" align="left"><b>challenger</b></td></tr><tr><td align="left">wealth</td><td align="left"><font point-size="8" color="#555555">varied in C1, C2, C4, C5, C8, C17</font></td></tr></table>>];
"incumbent" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#999999"><tr><td colspan="2" bgcolor="#c8e6c9" align="left"><b>incumbent</b></td></tr></table>>];
"institution" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#999999"><tr><td colspan="2" bgcolor="#c8e6c9" align="left"><b>institution</b></td></tr></table>>];
"position" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#999999"><tr><td colspan="2" bgcolor="#e3f2fd" align="left"><b>prize</b></td></tr><tr><td align="left">ranking</td><td align="left"><font point-size="8" color="#555555">varied in C16, C19</font></td></tr></table>>];
"credential" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#999999"><tr><td colspan="2" bgcolor="#e3f2fd" align="left"><b>bought component</b></td></tr><tr><td align="left">fee</td><td align="left"><font point-size="8" color="#555555">varied in C15, C16, C19</font></td></tr></table>>];
"rule" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#999999"><tr><td colspan="2" bgcolor="#e3f2fd" align="left"><b>published rule</b></td></tr><tr><td align="left">weight on the base component</td><td align="left"><font point-size="8" color="#555555">varied in C9, C10, C12, C13</font></td></tr></table>>];
"institution" -> "challenger" [label=<<b>admits</b><br/><font point-size="8">who is eligible; their number</font><br/><font point-size="8" color="#880e4f">number of challengers, varied in C7, C18</font>>, color="#0d47a1", fontcolor="#0d47a1"];
"institution" -> "rule" [label=<<b>publishes</b><br/><font point-size="8">the rule as published</font>>, color="#0d47a1", fontcolor="#0d47a1"];
"institution" -> "credential" [label=<<b>issues</b><br/><font point-size="8">at the fee</font>>, color="#0d47a1", fontcolor="#0d47a1"];
"incumbent" -> "position" [label=<<b>holds</b><br/><font point-size="8">the holder before the contest</font>>, color="#4e342e", fontcolor="#4e342e"];
"incumbent" -> "credential" [label=<<b>holds</b><br/><font point-size="8">scored as an entrant; buys it in M30</font>>, color="#4e342e", fontcolor="#4e342e"];
"challenger" -> "position" [label=<<b>competes for</b><br/><font point-size="8">every challenger; the score</font><br/><font point-size="8">score, varied in C14</font>>, color="#1b5e20", fontcolor="#1b5e20"];
"challenger" -> "credential" [label=<<b>buys</b><br/><font point-size="8">the entry decision, who paid</font><br/><font point-size="8" color="#880e4f">entrant set, varied in C3, C6, C11</font><br/><font point-size="8" color="#880e4f">entry count, responds in C1, C2, C3, C5, C6, C8, C9, C11, C12, C16, C17, C19; varied in C10, C13, C18</font><br/><font point-size="8" color="#880e4f">marginal entrant</font><br/><font point-size="8" color="#880e4f">assortative set, responds in C4, C15</font>>, color="#1b5e20", fontcolor="#1b5e20"];
"institution" -> "position" [label=<<b>awards</b><br/><font point-size="8">to the winner</font><br/><font point-size="8" color="#880e4f">entrants' share, responds in C10, C13, C18</font><br/><font point-size="8" color="#880e4f">first entrant's gain, responds in C7, C14</font>>, color="#0d47a1", fontcolor="#0d47a1"];
legend [label=<<table border="0" cellspacing="2"><tr><td align="left"><b>Nodes</b> are entities with their readable attributes, agents green and objects blue.</td></tr><tr><td align="left"><b>Edges</b> are actions, from the agent to what it acts on, with the record each leaves; in purple, the counts and patterns over edges of that kind.</td></tr><tr><td align="left">Each attribute or pattern lists the conclusions in which it varies or responds.</td></tr></table>>];
}
