digraph conclusions {
rankdir=LR; nodesep=0.25; ranksep=1.2; newrank=true;
node [fontname="Helvetica", fontsize=11]; edge [fontname="Helvetica", fontsize=9];
fontname="Helvetica";
subgraph cluster_agent { label="Agents"; style=rounded; color="#999999"; rank=same;
"challenger" [shape=box, style="rounded,filled", fillcolor="#c8e6c9", label=<challenger>];
"incumbent" [shape=box, style="rounded,filled", fillcolor="#c8e6c9", label=<incumbent>];
"institution" [shape=box, style="rounded,filled", fillcolor="#c8e6c9", label=<institution>];
}
subgraph cluster_object { label="Objects and their readable attributes"; style=rounded; color="#999999"; rank=same;
"rule" [shape=box, style="rounded,filled", fillcolor="#e3f2fd", label=<closure>];
"fee" [shape=box, style="rounded,filled", fillcolor="#e3f2fd", label=<fee<br/><font point-size="8">attribute of closure</font>>];
"decisiveness" [shape=box, style="rounded,filled", fillcolor="#e3f2fd", label=<decisive<br/><font point-size="8">attribute of closure</font>>];
"prize" [shape=box, style="rounded,filled", fillcolor="#e3f2fd", label=<prize>];
"prize_ranking" [shape=box, style="rounded,filled", fillcolor="#e3f2fd", label=<ranking<br/><font point-size="8">attribute of prize</font>>];
"Q" [shape=box, style="rounded,filled", fillcolor="#e3f2fd", label=<number of challengers>];
"profile" [shape=box, style="rounded,filled", fillcolor="#e3f2fd", label=<wealth>];
"scores" [shape=box, style="rounded,filled", fillcolor="#e3f2fd", label=<score>];
"change" [shape=box, style="rounded,filled", fillcolor="#e3f2fd", label=<pivot-spread<br/><font point-size="8">two recorded profiles</font>>];
}
subgraph cluster_action { label="Actions"; style=rounded; color="#999999"; rank=same;
"pays" [shape=hexagon, style="rounded,filled", fillcolor="#fff9c4", label=<pays>];
"incumbent_pays" [shape=hexagon, style="rounded,filled", fillcolor="#fff9c4", label=<pays, in M30>];
"sets_fee" [shape=hexagon, style="rounded,filled", fillcolor="#fff9c4", label=<sets>];
"publishes" [shape=hexagon, style="rounded,filled", fillcolor="#fff9c4", label=<publishes>];
"admits" [shape=hexagon, style="rounded,filled", fillcolor="#fff9c4", label=<admits>];
"awards" [shape=hexagon, style="rounded,filled", fillcolor="#fff9c4", label=<awards>];
}
subgraph cluster_measure { label="Measures of actions"; style=rounded; color="#999999"; rank=same;
"entrant_set" [shape=box, style="rounded,filled", fillcolor="#fce4ec", label=<entrant set>];
"count" [shape=box, style="rounded,filled", fillcolor="#fce4ec", label=<entry count>];
"marginal" [shape=box, style="rounded,filled", fillcolor="#fce4ec", label=<marginal entrant>];
"assortative" [shape=box, style="rounded,filled", fillcolor="#fce4ec", label=<assortative set>];
"lone_payer_gain" [shape=box, style="rounded,filled", fillcolor="#fce4ec", label=<first entrant's gain>];
"share" [shape=box, style="rounded,filled", fillcolor="#fce4ec", label=<entrants' share>];
}
"challenger" -> "pays" [color="black"];
"pays" -> "fee" [color="black"];
"incumbent" -> "incumbent_pays" [color="black"];
"incumbent_pays" -> "fee" [color="black"];
"institution" -> "sets_fee" [color="black"];
"sets_fee" -> "fee" [color="black"];
"institution" -> "publishes" [color="black"];
"publishes" -> "rule" [color="black"];
"institution" -> "admits" [color="black"];
"admits" -> "Q" [color="black"];
"institution" -> "awards" [color="black"];
"awards" -> "prize" [color="black"];
"scores" -> "awards" [label="read by", color="black", style=dotted];
"pays" -> "entrant_set" [color="#880e4f", style=dotted];
"pays" -> "count" [color="#880e4f", style=dotted];
"pays" -> "marginal" [color="#880e4f", style=dotted];
"pays" -> "assortative" [color="#880e4f", style=dotted];
"awards" -> "lone_payer_gain" [color="#880e4f", style=dotted];
"awards" -> "share" [color="#880e4f", style=dotted];
"rel_spread_sign" [shape=ellipse, color="#2e7d32", penwidth=2, fontsize=9, label=<sign set by the marginal entrant against the pivot<br/><font point-size="8">C1, C5; new</font>>];
"change" -> "rel_spread_sign" [color="#2e7d32"];
"rel_spread_sign" -> "count" [color="#2e7d32", penwidth=1.6];
"marginal" -> "rel_spread_sign" [color="#2e7d32", style=dashed, arrowhead=odot];
"rel_two_ranks" [shape=ellipse, color="#1565c0", penwidth=2, fontsize=9, label=<signed by the change at two ranks, outside the band<br/><font point-size="8">C2, C8; sharpening</font>>];
"change" -> "rel_two_ranks" [color="#1565c0"];
"rel_two_ranks" -> "count" [color="#1565c0", penwidth=1.6];
"marginal" -> "rel_two_ranks" [color="#1565c0", style=dashed, arrowhead=odot];
"rel_count_pinned" [shape=ellipse, color="#2e7d32", penwidth=2, fontsize=9, label=<the same in every equilibrium<br/><font point-size="8">C3, C6; new</font>>];
"entrant_set" -> "rel_count_pinned" [color="#2e7d32"];
"rel_count_pinned" -> "count" [color="#2e7d32", penwidth=1.6];
"scores" -> "rel_count_pinned" [color="#2e7d32", style=dashed, arrowhead=odot];
"rel_who_enters" [shape=ellipse, color="#00838f", penwidth=2, fontsize=9, label=<the richest paying is always an equilibrium<br/><font point-size="8">C4; settled</font>>];
"profile" -> "rel_who_enters" [color="#00838f"];
"rel_who_enters" -> "assortative" [color="#00838f", penwidth=1.6];
"rel_gain_form" [shape=ellipse, color="#6a1b9a", penwidth=2, fontsize=9, label=<the form of Ryvkin and Drugov's marginal benefit<br/><font point-size="8">C14; credited</font>>];
"scores" -> "rel_gain_form" [color="#6a1b9a"];
"rel_gain_form" -> "lone_payer_gain" [color="#6a1b9a", penwidth=1.6];
"rel_gain_in_Q" [shape=ellipse, color="#2e7d32", penwidth=2, fontsize=9, label=<never falls<br/><font point-size="8">C7; new</font>>];
"Q" -> "rel_gain_in_Q" [color="#2e7d32"];
"rel_gain_in_Q" -> "lone_payer_gain" [color="#2e7d32", penwidth=1.6];
"rel_closure_sign" [shape=ellipse, color="#2e7d32", penwidth=2, fontsize=9, label=<does not rise as the credential is less decisive<br/><font point-size="8">C9, C12; new/opposite</font>>];
"decisiveness" -> "rel_closure_sign" [color="#2e7d32"];
"rel_closure_sign" -> "count" [color="#2e7d32", penwidth=1.6];
"incumbent" -> "rel_closure_sign" [color="#2e7d32", style=dashed, arrowhead=odot];
"rel_share_follows" [shape=ellipse, color="#2e7d32", penwidth=2, fontsize=9, label=<moves with the count; does not rise as the credential is less decisive<br/><font point-size="8">C10, C13; new</font>>];
"count" -> "rel_share_follows" [color="#2e7d32"];
"decisiveness" -> "rel_share_follows" [color="#2e7d32"];
"rel_share_follows" -> "share" [color="#2e7d32", penwidth=1.6];
"rel_incumbent_entry" [shape=ellipse, color="#616161", penwidth=2, fontsize=9, label=<the incumbent sits out while a challenger pays only in one of several equilibria<br/><font point-size="8">C11; model</font>>];
"entrant_set" -> "rel_incumbent_entry" [color="#616161"];
"rel_incumbent_entry" -> "count" [color="#616161", penwidth=1.6];
"incumbent" -> "rel_incumbent_entry" [color="#616161", style=dashed, arrowhead=odot];
"rel_fee_order" [shape=ellipse, color="#ef6c00", penwidth=2, fontsize=9, label=<a uniform fee changes how many pay, not the order<br/><font point-size="8">C15; implication</font>>];
"fee" -> "rel_fee_order" [color="#ef6c00"];
"rel_fee_order" -> "assortative" [color="#ef6c00", penwidth=1.6];
"rel_prize_cap" [shape=ellipse, color="#ef6c00", penwidth=2, fontsize=9, label=<the prize caps how many pay; the cap sets a fee<br/><font point-size="8">C16; implication</font>>];
"prize_ranking" -> "rel_prize_cap" [color="#ef6c00"];
"fee" -> "rel_prize_cap" [color="#ef6c00"];
"rel_prize_cap" -> "count" [color="#ef6c00", penwidth=1.6];
"rel_compression" [shape=ellipse, color="#ef6c00", penwidth=2, fontsize=9, label=<read at two ranks; no general sign for less inequality<br/><font point-size="8">C17; implication</font>>];
"change" -> "rel_compression" [color="#ef6c00"];
"rel_compression" -> "count" [color="#ef6c00", penwidth=1.6];
"marginal" -> "rel_compression" [color="#ef6c00", style=dashed, arrowhead=odot];
"rel_share_benchmark" [shape=ellipse, color="#ef6c00", penwidth=2, fontsize=9, label=<above the benchmark only if the credential counts<br/><font point-size="8">C18; implication</font>>];
"count" -> "rel_share_benchmark" [color="#ef6c00"];
"Q" -> "rel_share_benchmark" [color="#ef6c00"];
"rel_share_benchmark" -> "share" [color="#ef6c00", penwidth=1.6];
legend [shape=plaintext, fontsize=9, label=<<table border="0" cellspacing="2"><tr><td align="left"><b>Boxes</b> are observable rows of the measurement map</td></tr><tr><td align="left">black edge, an action from its agent to its object (table of players)</td></tr><tr><td align="left">dotted edge, a measure computed from an action's record</td></tr><tr><td align="left"><b>Ellipses</b> are relations the conclusions state; colour is their standing; in from what varies, out to the measure, dashed from a condition</td></tr><tr><td align="left"><font color="#2e7d32">new</font></td></tr><tr><td align="left"><font color="#1565c0">sharpening</font></td></tr><tr><td align="left"><font color="#6a1b9a">credited</font></td></tr><tr><td align="left"><font color="#00838f">settled</font></td></tr><tr><td align="left"><font color="#c62828">opposite</font></td></tr><tr><td align="left"><font color="#ef6c00">implication</font></td></tr><tr><td align="left"><font color="#616161">model</font></td></tr></table>>];
}
