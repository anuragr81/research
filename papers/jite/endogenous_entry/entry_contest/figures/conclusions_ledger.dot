digraph conclusions {
rankdir=LR; nodesep=0.3; ranksep=1.4; newrank=true;
node [fontname="Helvetica", fontsize=11]; edge [fontname="Helvetica", fontsize=9];
fontname="Helvetica";
subgraph cluster_player { label="Players"; style=rounded; color="#999999"; rank=same;
"challenger" [shape=box, style="rounded,filled", fillcolor="#c8e6c9", label=<challenger<br/><font point-size="9">observed R</font>>];
"incumbent" [shape=box, style="rounded,filled", fillcolor="#c8e6c9", label=<incumbent<br/><font point-size="9">observed R</font>>];
"nature" [shape=box, style="rounded,filled", fillcolor="#eeeeee", label=<nature<br/><font point-size="9">observed N</font>>];
"institution" [shape=box, style="rounded,filled", fillcolor="#c8e6c9", label=<institution<br/><font point-size="9">observed R</font>>];
}
subgraph cluster_input { label="Inputs"; style=rounded; color="#999999"; rank=same;
"Q" [shape=box, style="rounded,filled", fillcolor="#c8e6c9", label=<number of challengers<br/><font point-size="9">observed R</font>>];
"C" [shape=box, style="rounded,filled", fillcolor="#eeeeee", label=<scored as an entrant<br/><font point-size="9">observed N</font>>];
"w" [shape=box, style="rounded,filled", fillcolor="#c8e6c9", label=<wealth<br/><font point-size="9">observed R</font>>];
"c" [shape=box, style="rounded,filled", fillcolor="#c8e6c9", label=<fee<br/><font point-size="9">observed R</font>>];
"V" [shape=box, style="rounded,filled", fillcolor="#ffe0b2", label=<prize<br/><font point-size="9">observed K</font>>];
"mu" [shape=box, style="rounded,filled", fillcolor="#eeeeee", label=<weight on the base component<br/><font point-size="9">observed N</font>>];
"r" [shape=box, style="rounded,filled", fillcolor="#eeeeee", label=<base component<br/><font point-size="9">observed N</font>>];
"s" [shape=box, style="rounded,filled", fillcolor="#eeeeee", label=<bought component<br/><font point-size="9">observed N</font>>];
"T" [shape=box, style="rounded,filled", fillcolor="#c8e6c9", label=<pivot-spread<br/><font point-size="9">observed R</font>>];
"x0" [shape=box, style="rounded,filled", fillcolor="#bbdefb", label=<pivot<br/><font point-size="9">observed C</font>>];
}
subgraph cluster_internal { label="Model-internal variables"; style=rounded; color="#999999"; rank=same;
"kappa" [shape=box, style="rounded,filled", fillcolor="#ffe0b2", label=<entry cost<br/><font point-size="9">observed K</font>>];
"Delta" [shape=box, style="rounded,filled", fillcolor="#ffe0b2", label=<gain<br/><font point-size="9">observed K</font>>];
"cap" [shape=box, style="rounded,filled", fillcolor="#bbdefb", label=<saturation<br/><font point-size="9">observed C</font>>];
"pinned" [shape=box, style="rounded,filled", fillcolor="#ffe0b2", label=<identities pinned<br/><font point-size="9">observed K</font>>];
"band" [shape=box, style="rounded,filled", fillcolor="#bbdefb", label=<band<br/><font point-size="9">observed C</font>>];
"gain_Q" [shape=box, style="rounded,filled", fillcolor="#bbdefb", label=<first entrant's gain<br/><font point-size="9">observed C</font>>];
}
subgraph cluster_output { label="Outputs"; style=rounded; color="#999999"; rank=same;
"e" [shape=box, style="rounded,filled", fillcolor="#c8e6c9", label=<enter<br/><font point-size="9">observed R</font>>];
"S" [shape=box, style="rounded,filled", fillcolor="#c8e6c9", label=<entrant set<br/><font point-size="9">observed R</font>>];
"kstar" [shape=box, style="rounded,filled", fillcolor="#c8e6c9", label=<entry count<br/><font point-size="9">observed R</font>>];
"marginal" [shape=box, style="rounded,filled", fillcolor="#bbdefb", label=<marginal entrant<br/><font point-size="9">observed C</font>>];
"assortative" [shape=box, style="rounded,filled", fillcolor="#bbdefb", label=<assortative set<br/><font point-size="9">observed C</font>>];
"share" [shape=box, style="rounded,filled", fillcolor="#c8e6c9", label=<entrants' share<br/><font point-size="9">observed R</font>>];
}
"challenger" -> "e" [color="black", penwidth=1.4, label="chooses", fontsize=8];
"incumbent" -> "e" [color="black", penwidth=1.4, label="chooses in M30", fontsize=8];
"nature" -> "r" [color="black", penwidth=1.4, label="draws", fontsize=8];
"nature" -> "s" [color="black", penwidth=1.4, label="draws", fontsize=8];
"institution" -> "V" [color="black", penwidth=1.4, label="sets", fontsize=8];
"institution" -> "c" [color="black", penwidth=1.4, label="sets", fontsize=8];
"institution" -> "mu" [color="black", penwidth=1.4, label="sets", fontsize=8];
"rel_spread_sign" [shape=ellipse, color="#2e7d32", penwidth=2, fontsize=10, label=<sign set by<br/><font point-size="8">C1, C5; new</font>>];
"T" -> "rel_spread_sign" [color="#2e7d32"];
"x0" -> "rel_spread_sign" [color="#2e7d32"];
"rel_spread_sign" -> "kstar" [color="#2e7d32", penwidth=1.6];
"marginal" -> "rel_spread_sign" [color="#2e7d32", style=dashed, arrowhead=odot];
"kappa" -> "rel_spread_sign" [color="#2e7d32", style=dashed, arrowhead=odot];
"rel_two_ranks" [shape=ellipse, color="#1565c0", penwidth=2, fontsize=10, label=<sign set by<br/><font point-size="8">C2, C8; sharpening</font>>];
"T" -> "rel_two_ranks" [color="#1565c0"];
"rel_two_ranks" -> "kstar" [color="#1565c0", penwidth=1.6];
"marginal" -> "rel_two_ranks" [color="#1565c0", style=dashed, arrowhead=odot];
"band" -> "rel_two_ranks" [color="#1565c0", style=dashed, arrowhead=odot];
"rel_count_pinned" [shape=ellipse, color="#2e7d32", penwidth=2, fontsize=10, label=<pinned by<br/><font point-size="8">C3, C6; new</font>>];
"Delta" -> "rel_count_pinned" [color="#2e7d32"];
"rel_count_pinned" -> "kstar" [color="#2e7d32", penwidth=1.6];
"w" -> "rel_count_pinned" [color="#2e7d32", style=dashed, arrowhead=odot];
"rel_who_enters" [shape=ellipse, color="#00838f", penwidth=2, fontsize=10, label=<selects<br/><font point-size="8">C4; settled</font>>];
"w" -> "rel_who_enters" [color="#00838f"];
"kappa" -> "rel_who_enters" [color="#00838f"];
"rel_who_enters" -> "assortative" [color="#00838f", penwidth=1.6];
"pinned" -> "rel_who_enters" [color="#00838f", style=dashed, arrowhead=odot];
"rel_gain_form" [shape=ellipse, color="#6a1b9a", penwidth=2, fontsize=10, label=<takes the form<br/><font point-size="8">C14; credited</font>>];
"Delta" -> "rel_gain_form" [color="#6a1b9a"];
"rel_gain_form" -> "gain_Q" [color="#6a1b9a", penwidth=1.6];
"rel_gain_in_Q" [shape=ellipse, color="#2e7d32", penwidth=2, fontsize=10, label=<never falls in<br/><font point-size="8">C7; new</font>>];
"Q" -> "rel_gain_in_Q" [color="#2e7d32"];
"rel_gain_in_Q" -> "gain_Q" [color="#2e7d32", penwidth=1.6];
"r" -> "rel_gain_in_Q" [color="#2e7d32", style=dashed, arrowhead=odot];
"rel_weight_sign" [shape=ellipse, color="#2e7d32", penwidth=2, fontsize=10, label=<does not rise in<br/><font point-size="8">C9, C12; new/opposite</font>>];
"mu" -> "rel_weight_sign" [color="#2e7d32"];
"rel_weight_sign" -> "kstar" [color="#2e7d32", penwidth=1.6];
"C" -> "rel_weight_sign" [color="#2e7d32", style=dashed, arrowhead=odot];
"rel_share_follows" [shape=ellipse, color="#2e7d32", penwidth=2, fontsize=10, label=<moves with<br/><font point-size="8">C10, C13; new</font>>];
"kstar" -> "rel_share_follows" [color="#2e7d32"];
"mu" -> "rel_share_follows" [color="#2e7d32"];
"rel_share_follows" -> "share" [color="#2e7d32", penwidth=1.6];
"rel_incumbent_entry" [shape=ellipse, color="#616161", penwidth=2, fontsize=10, label=<selects<br/><font point-size="8">C11; model</font>>];
"kappa" -> "rel_incumbent_entry" [color="#616161"];
"rel_incumbent_entry" -> "S" [color="#616161", penwidth=1.6];
"C" -> "rel_incumbent_entry" [color="#616161", style=dashed, arrowhead=odot];
"pinned" -> "rel_incumbent_entry" [color="#616161", style=dashed, arrowhead=odot];
"rel_fee_order" [shape=ellipse, color="#ef6c00", penwidth=2, fontsize=10, label=<orders<br/><font point-size="8">C15; implication</font>>];
"c" -> "rel_fee_order" [color="#ef6c00"];
"w" -> "rel_fee_order" [color="#ef6c00"];
"rel_fee_order" -> "assortative" [color="#ef6c00", penwidth=1.6];
"kappa" -> "rel_fee_order" [color="#ef6c00", style=dashed, arrowhead=odot];
"rel_prize_cap" [shape=ellipse, color="#ef6c00", penwidth=2, fontsize=10, label=<caps<br/><font point-size="8">C16; implication</font>>];
"V" -> "rel_prize_cap" [color="#ef6c00"];
"kappa" -> "rel_prize_cap" [color="#ef6c00"];
"rel_prize_cap" -> "kstar" [color="#ef6c00", penwidth=1.6];
"cap" -> "rel_prize_cap" [color="#ef6c00", style=dashed, arrowhead=odot];
"rel_compression" [shape=ellipse, color="#ef6c00", penwidth=2, fontsize=10, label=<sign set by<br/><font point-size="8">C17; implication</font>>];
"T" -> "rel_compression" [color="#ef6c00"];
"x0" -> "rel_compression" [color="#ef6c00"];
"rel_compression" -> "kstar" [color="#ef6c00", penwidth=1.6];
"marginal" -> "rel_compression" [color="#ef6c00", style=dashed, arrowhead=odot];
"band" -> "rel_compression" [color="#ef6c00", style=dashed, arrowhead=odot];
"rel_share_benchmark" [shape=ellipse, color="#ef6c00", penwidth=2, fontsize=10, label=<shows<br/><font point-size="8">C18; implication</font>>];
"share" -> "rel_share_benchmark" [color="#ef6c00"];
"kstar" -> "rel_share_benchmark" [color="#ef6c00"];
"Q" -> "rel_share_benchmark" [color="#ef6c00"];
"rel_share_benchmark" -> "s" [color="#ef6c00", penwidth=1.6];
legend [shape=plaintext, fontsize=9, label=<<table border="0" cellspacing="2"><tr><td align="left"><b>Fill: Observed code of the map</b></td></tr><tr><td bgcolor="#c8e6c9" align="left">R recorded</td></tr><tr><td bgcolor="#bbdefb" align="left">C computed from records</td></tr><tr><td bgcolor="#eeeeee" align="left">N not observed, a fact</td></tr><tr><td bgcolor="#ffe0b2" align="left">K not observed, a construct</td></tr><tr><td align="left"><b>Black: a player's option</b> (table of players)</td></tr><tr><td align="left"><b>Relation colour: standing</b> (C rows; dashed = condition)</td></tr><tr><td align="left"><font color="#2e7d32">new</font></td></tr><tr><td align="left"><font color="#1565c0">sharpening</font></td></tr><tr><td align="left"><font color="#6a1b9a">credited</font></td></tr><tr><td align="left"><font color="#00838f">settled</font></td></tr><tr><td align="left"><font color="#c62828">opposite</font></td></tr><tr><td align="left"><font color="#ef6c00">implication</font></td></tr><tr><td align="left"><font color="#616161">model</font></td></tr></table>>];
}
