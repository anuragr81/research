\begin_layout Standard
To calculate 
\begin_inset Formula $\int_{s=0}^{s=1}\int_{r=0}^{r=1}P(\text{win}|r,s)drds$
\end_inset

 over the variable 
\begin_inset Formula $x$
\end_inset

 (where 
\begin_inset Formula $0<r<1$
\end_inset

 and 
\begin_inset Formula $0<s<1$
\end_inset

),
 we evaluate the sum of three parts split by the boundaries of the piecewise function.
 The three parts are shown in Figure 
\begin_inset CommandInset ref
LatexCommand ref
reference "fig:integral_boundaries"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

.
 If 
\begin_inset Formula $x=\mu r+(1-\mu)s$
\end_inset

 and 
\begin_inset Formula $F(x)$
\end_inset

 is of the following piece-wise form
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
F(x) & =\begin{cases}
A & 0<x<\mu\\
B & \mu<x<1-\mu\\
C & 1-\mu<x<1\\
0 & \text{otherwise}
\end{cases}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Then the integral 
\begin_inset Formula $\int_{s=0}^{s=1}\int_{r=0}^{r=1}F(x)drds$
\end_inset

 can be written as
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\int_{s=0}^{s=1}\int_{r=0}^{r=1}F(x)dsdr & =\int_{r=0}^{r=1}{\int_{s=0}^{s=\frac{\mu(1-r)}{1-\mu}}A\ dsdr}+\int_{r=0}^{r=1}{\int_{s=\frac{\mu(1-r)}{1-\mu}}^{s=1-\frac{\mu r}{1-\mu}}B\ dsdr}+\int_{r=0}^{r=1}{\int_{s=1-\frac{\mu r}{1-\mu}}^{s=1}C\ dsdr}
\end{align*}

\end_inset


\end_layout

