digraph ledger {
  rankdir=LR; node [fontname="Helvetica", fontsize=11]; edge [fontname="Helvetica", fontsize=9];
  "bank" [shape=ellipse, label="bank\n(N1)\nCERT\nASSET\nLIAB\nRWAJT"];
  "equity" [shape=box, label="equity\n(N2)\nRBCT1J\nRBCT2"];
  "investors" [shape=ellipse, label="investors\n(N3)\nRSSDHCR"];
  "insured creditors" [shape=ellipse, label="insured creditors\n(N4)\nDEPINS"];
  "uninsured creditors" [shape=ellipse, label="uninsured creditors\n(N5)\nVOLIAB\nDEPUNA"];
  "supervisor" [shape=ellipse, label="supervisor\n(N6)\nREGAGNT"];
  "insurer" [shape=ellipse, label="insurer\n(N7)"];
  "bank" -> "investors" [label="A1 pays dividends\nEQCDIV"];
  "investors" -> "equity" [label="A2 buy stock, net\nEQCSXQ"];
  "investors" -> "equity" [label="A3 inject capital (parent)\nEQCBHCTR"];
  "insured creditors" -> "bank" [label="A4 deposit and withdraw\nDEPINS"];
  "bank" -> "bank" [label="A5 takes risky exposure\nRWAJT, ASSET"];
  "supervisor" -> "bank" [label="A6 supervises\nREGAGNT"];
  "uninsured creditors" -> "bank" [label="A7 lend and withdraw\nVOLIAB, DEPUNA"];
  "insurer" -> "insured creditors" [label="A8 insures\nDEPINS"];
  "supervisor" -> "bank" [label="A9 assigns capital category, restricts\nRBCT1J, RWAJT"];
  "supervisor" -> "bank" [label="A10 closes\n"];
  "insurer" -> "bank" [label="A11 prices insurance on capital\n"];
}
