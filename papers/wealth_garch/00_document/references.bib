% barberis2001: NBER WP 7220 text read; QJE 116(1):1-53 confirmed against
% the JSTOR listing and multiple independent reference lists. The
% qualitative claim used here -- that excess volatility in their model comes
% from TIME-VARYING loss aversion, not from its level -- is stated in their
% own abstract ("the key to our results is that the agent's risk-aversion
% changes over time...this makes prices much more volatile than underlying
% dividends"). The specific quantitative figures in project notes (0.91%
% premium, 1.2% cap, 13.3% vol) are from the WP and are NOT re-verified;
% check them against the published article before quoting any in print.
@article{barberis2001,
  author  = {Barberis, Nicholas and Huang, Ming and Santos, Tano},
  title   = {Prospect Theory and Asset Prices},
  journal = {The Quarterly Journal of Economics},
  year    = {2001},
  volume  = {116},
  number  = {1},
  pages   = {1--53},
  doi     = {10.1162/003355301556310}
}

% engle2018: published RFS version read in full (via MFM/Chicago copy of the
% OUP typeset article); volume/issue/pages/doi read off the article's own
% header and cross-checked against the RePEc listing. Findings used: their
% asymmetry measures are the correlation rho(|x_t|,x_{t-1}) and the GJR
% gamma -- NOT a deficit/surplus variance ratio. Median gamma_E 0.081,
% gamma_A 0.070, gamma_I 0.015; median gamma_A/gamma_E 0.86 (leverage ~14%).
% Median rho_E -0.045, rho_A -0.043, rho_I -0.003; median rho_A/rho_E 0.97
% (leverage ~3%); median rho_I/rho_E 0.17, so aggregate-market exposure is
% ~80%. Sample 91 financial firms 1998-2016/06; asymmetry tables use the 69
% firms with phi != 0.
@article{engle2018,
  author  = {Engle, Robert F. and Siriwardane, Emil N.},
  title   = {Structural {GARCH}: The Volatility-Leverage Connection},
  journal = {The Review of Financial Studies},
  year    = {2018},
  volume  = {31},
  number  = {2},
  pages   = {449--492},
  doi     = {10.1093/rfs/hhx099}
}
